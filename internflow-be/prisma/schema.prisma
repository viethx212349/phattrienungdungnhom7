generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model interns {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  full_name      String
  intern_code    String          @unique
  position       String?
  email          String?
  phone          String?
  school         String?
  status         intern_status   @default(ACTIVE)
  final_feedback String?
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  notifications  notifications[]
  tasks          tasks[]
}

model notifications {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  intern_id  String            @db.Uuid
  task_id    String?           @db.Uuid
  title      String
  message    String
  type       notification_type
  is_read    Boolean           @default(false)
  created_at DateTime          @default(now()) @db.Timestamptz(6)
  interns    interns           @relation(fields: [intern_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tasks      tasks?            @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([intern_id], map: "idx_notifications_intern_id")
  @@index([is_read], map: "idx_notifications_is_read")
  @@index([task_id], map: "idx_notifications_task_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model task_attachments {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  task_id    String          @db.Uuid
  file_name  String
  file_url   String
  file_size  BigInt?
  type       attachment_type
  created_at DateTime        @default(now()) @db.Timestamptz(6)
  tasks      tasks           @relation(fields: [task_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([task_id], map: "idx_task_attachments_task_id")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model tasks {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  intern_id          String?            @db.Uuid
  title              String
  description        String?
  status             task_status        @default(TODO)
  rejected_count     Int                @default(0)
  due_date           DateTime?          @db.Timestamptz(6)
  assigned_at        DateTime?          @db.Timestamptz(6)
  submitted_at       DateTime?          @db.Timestamptz(6)
  closed_at          DateTime?          @db.Timestamptz(6)
  mentor_feedback    String?
  submission_link    String?
  submission_summary String?
  created_at         DateTime           @default(now()) @db.Timestamptz(6)
  updated_at         DateTime           @default(now()) @db.Timestamptz(6)
  notifications      notifications[]
  task_attachments   task_attachments[]
  interns            interns?           @relation(fields: [intern_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([due_date], map: "idx_tasks_due_date")
  @@index([intern_id], map: "idx_tasks_intern_id")
  @@index([intern_id, status], map: "idx_tasks_intern_status")
  @@index([status], map: "idx_tasks_status")
}

enum attachment_type {
  MENTOR_DOC
  INTERN_SUBMIT
}

enum intern_status {
  ACTIVE
  PASSED
  FAILED
}

enum notification_type {
  NEW_TASK
  REMINDER
  REJECTED
}

enum task_status {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}
