{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    // ========= ĐÃ XÓA "baseUrl": "." =========
    "paths": {
      "@/*": ["./src/*"]   // Quan trọng: phải có tiền tố "./"
    }
    // ========================================
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}